{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "guild-channel",
            "guild-thread",
            "dm",
            "group-dm",
            "unknown"
          ]
        },
        "guildId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "guildName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "channelId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "channelName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "parentChannelId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "threadId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "participantIds": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          }
        }
      },
      "required": [
        "kind",
        "guildId",
        "guildName",
        "channelId",
        "channelName",
        "parentChannelId",
        "threadId",
        "participantIds"
      ],
      "additionalProperties": false
    },
    "messages": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "senderId": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "editedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "messageId",
          "senderId",
          "createdAt",
          "editedAt",
          "content"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "accountId",
    "provenance",
    "messages"
  ],
  "additionalProperties": false
}
