{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "context": {
      "type": "string",
      "enum": [
        "collector-vault/v1",
        "coordination-batch/v1"
      ]
    },
    "kdf": {
      "type": "string",
      "const": "PBKDF2-SHA256"
    },
    "iterations": {
      "type": "number",
      "const": 600000
    },
    "cipher": {
      "type": "string",
      "const": "AES-256-GCM"
    },
    "salt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "iv": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "ciphertext": {
      "type": "string",
      "minLength": 24,
      "maxLength": 12582912,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    }
  },
  "required": [
    "version",
    "context",
    "kdf",
    "iterations",
    "cipher",
    "salt",
    "iv",
    "ciphertext"
  ],
  "additionalProperties": false
}
